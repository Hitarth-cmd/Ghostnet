# Copy to .env and adjust. All variables have safe DEMO defaults - the
# platform runs fully without setting anything below.

APP_ENV=development
DATA_MODE=demo

# SQLite is used by default (zero external services). For production,
# point at a PostgreSQL/PostGIS instance, e.g.:
# DATABASE_URL=postgresql+psycopg://ghostnet:ghostnet@localhost:5432/ghostnet
DATABASE_URL=sqlite:///./ghostnet_demo.db

# Leave REDIS_URL empty / JOB_BACKEND=inline to run background jobs on an
# in-process thread with no Redis/Celery required (DEMO mode default).
REDIS_URL=
JOB_BACKEND=inline

# mock (default, always works) or sentinel2 (requires a real trained
# checkpoint - see README "Model integration").
MODEL_PROVIDER=mock
MODEL_CHECKPOINT_PATH=

# demo (default, synthetic deterministic ocean/wind fields) or a live
# provider name (cmems/era5/gfs) - falls back to demo automatically if
# credentials are missing.
OCEAN_DATA_PROVIDER=demo
CMEMS_USERNAME=
CMEMS_PASSWORD=

# RAG configuration. "hashing" embeddings require no download/API key.
VECTOR_STORE=memory
EMBEDDING_PROVIDER=hashing

# LLM provider for report narration. "mock" requires no API key.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Frontend (see frontend/.env.local.example for the Next.js side)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
